rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function member(companyId){return signedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));}
  function admin(companyId){return member(companyId) && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role in ['owner','admin'];}
  match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
  match /mail/{mailId} {
   allow create: if signedIn() &&
    request.resource.data.companyId is string &&
    admin(request.resource.data.companyId) &&
    request.resource.data.invitationEmail is string &&
    request.resource.data.to is list &&
    request.resource.data.to.size() == 1 &&
    request.resource.data.to[0] == request.resource.data.invitationEmail &&
    exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationEmail)) &&
    get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationEmail)).data.companyId == request.resource.data.companyId;
   allow read, update, delete: if false;
  }
  match /invitations/{email} {
   allow create: if signedIn() && admin(request.resource.data.companyId) && request.resource.data.email == email && request.resource.data.role in ['admin','viewer'];
   allow read, delete: if signedIn() && (resource.data.email == request.auth.token.email || admin(resource.data.companyId));
  }
  match /companies/{companyId} {
   allow read: if member(companyId) || (signedIn() && resource.data.ownerUid == request.auth.uid); allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid; allow update,delete: if admin(companyId);
   match /members/{uid} {
    allow read: if member(companyId);
    allow create: if signedIn() && request.auth.uid == uid && (
     get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid ||
     (exists(/databases/$(database)/documents/invitations/$(request.auth.token.email)) &&
      get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.companyId == companyId &&
      request.resource.data.role == get(/databases/$(database)/documents/invitations/$(request.auth.token.email)).data.role)
    );
    allow update,delete: if admin(companyId);
   }
   match /officers/{officerId} {allow read: if member(companyId); allow write: if admin(companyId);}
   match /siaLicences/{licenceId} {allow read: if member(companyId); allow write: if admin(companyId);}
  }
 }
}
